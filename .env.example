# ais-its-auth-service — every variable the service reads (docs/PLATFORM_SPEC.md §4).
# Copy to .env for local development; real secrets never go into the repository.

# --- Service -------------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=auth
# Defaults to the package.json version.
# SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
# Pretty logs need the dev dependency pino-pretty; defaults to true in development.
LOG_PRETTY=true
# Graceful shutdown deadline (SIGTERM → readiness 503 → drain → exit).
SHUTDOWN_TIMEOUT_MS=30000

# --- PostgreSQL (TimescaleDB + PostGIS), schema "auth" ---------------------
DATABASE_URL=postgres://auth_svc:auth_svc@localhost:5432/aisits
DATABASE_SCHEMA=auth
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Apply migrations/ at startup (also `pnpm migrate`).
DB_MIGRATE_ON_BOOT=true

# --- NATS JetStream --------------------------------------------------------------
# Comma separated list allowed. Produces NOTIFY and AUDIT, consumes AUDIT (durable auth-audit).
NATS_URL=nats://localhost:4222
# Prefix of every durable consumer name (only for test suites sharing one server).
# NATS_DURABLE_PREFIX=

# --- Valkey: login/MFA/forgot-password throttles, single-use MFA codes ------------
REDIS_URL=redis://localhost:6379

# --- Authentication (spec §8) ----------------------------------------------------
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
AUTH_ISSUER=ais-its-auth
AUTH_AUDIENCE=ais-its-api
# API-key introspection (routes marked @AllowApiKey).
AUTH_INTERNAL_URL=http://localhost:3001
# X-Internal-Token for /internal/* — at least 16 characters and not this value in production.
INTERNAL_TOKEN=dev-internal-token-change-me

# --- HTTP ------------------------------------------------------------------------
# Also the allow-list of the Origin check of the cookie endpoints (refresh, logout).
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
# Base of the links in e-mails (reset-password, accept-invite); its origin may use the cookie too.
PUBLIC_BASE_URL=http://localhost:8000
# Proxies whose X-Forwarded-For is trusted (client IP of per-IP throttles, sessions and audit records):
# comma list of IPs/CIDRs or loopback, linklocal, uniquelocal; "none" trusts nobody. In production
# name the gateway only, or any client on a private network can choose its IP. A forwarded value
# that is not an IP address (e.g. "foo", "1.2.3.4:5678" is reduced to 1.2.3.4) is stored as null.
TRUSTED_PROXIES=loopback,linklocal,uniquelocal

# --- Auth service (spec §13.1) ---------------------------------------------------
# Master secret (32+ characters) of the AES-256-GCM keys (HKDF-SHA256) sealing the signing
# private keys and MFA secrets. Required in production (the development default is refused).
# Changing it makes the stored keys and MFA secrets unreadable — rotate it with
# KEY_ENCRYPTION_SECRET_PREVIOUS and `pnpm rotate:key-secret` instead (README, Operations).
KEY_ENCRYPTION_SECRET=dev-key-encryption-secret-change-me-0123456789
# The old secret during a rotation (opens values it sealed); unset otherwise.
# KEY_ENCRYPTION_SECRET_PREVIOUS=
# Access token lifetime, seconds (60..3600). Also the grace period of rotated signing keys.
ACCESS_TOKEN_TTL=900
# Refresh token / session inactivity lifetime, days (1..365).
REFRESH_TOKEN_TTL_DAYS=30
# Secure flag of the aisits_rt cookie. Unset: true in production, false otherwise (plain HTTP dev).
COOKIE_SECURE=false
# Super admin created on an empty database (with the platform organization).
# The default password is refused in production.
BOOTSTRAP_ADMIN_EMAIL=admin@ais-its.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
# Validity of password reset links, minutes (5..1440).
PASSWORD_RESET_TTL_MIN=30
# Validity of invitation links, hours (1..720).
INVITE_TTL_HOURS=168
# Locale of transactional e-mails when the request names none (id | en).
EMAIL_DEFAULT_LOCALE=id
# Password of the users created by `pnpm seed:demo` (10+ characters, letters and digits).
SEED_DEMO_PASSWORD=DemoPass2026
# `pnpm seed:demo` refuses NODE_ENV=production unless this is true AND SEED_DEMO_PASSWORD is not
# the default above (the seed creates a super admin and two live API keys).
SEED_DEMO_ALLOW_PRODUCTION=false

# --- Tracing (OTLP/HTTP; disabled when unset) --------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
